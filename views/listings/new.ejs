<% layout("/layouts/boilerplate") %>

<body>
    <h3>Create a New Listing</h3>  
    <div class="row">
       <div class="col-8 offset-2">

         <form method="POST" action="/listings">
      <div class="mt-3">
          <label for="title" class="form-label">Title:</label>
      <input name="listing[title]" placeholder="enter title" type="text" class="form-control">
      </div>
   

      <br><br>
      <div >
        <label for="description" class="form-label">Description:</label>
        <textarea name="listing[description]" id="enter description" placeholder="enter description" class="form-control"></textarea>
      </div>
      <br><br>
      <div>
        <label for="image" class="form-label">Image URL:</label>
        <input name="listing[image]" placeholder="enter image URL/link" type="text" class="form-control">
      </div>
      <br><br>
     <div class="row">
         <div class="col-md-4">
        <label for="price" class="form-label">Price:</label>
        <input name="listing[price]" placeholder="enter price" type="number" class="form-control">
      </div>
      <br><br>
      <div class="col-md-8">
        <label for="country" class="form-label">Country:</label>
        <input name="listing[country]" placeholder="enter country" type="text" class="form-control">
      </div>
     </div>
      <br><br>
      <div>
        <label for="location" class="form-label">Location:</label>
        <input name="listing[location]" placeholder="enter location" type="text" class="form-control">
      </div>
      <br><br>
      <button type="submit" class="btn btn-dark add-btn mb-3">ADD</button>    
    </form>



       </div>
    </div>
   
   
</body>
